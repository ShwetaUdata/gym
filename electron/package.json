{
  "name": "powerfit-gym",
  "version": "1.0.0",
  "description": "PowerFit Gym Management System - Desktop Application",
  "main": "main.js",
  "author": "PowerFit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.powerfit.gym",
    "productName": "PowerFit Gym",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "server.js",
      "../dist/**/*",
      "../public/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../public/icons/icon-192x192.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "../public/icons/icon-192x192.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../public/icons/icon-192x192.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../public/icons/icon-192x192.png"
    }
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "nodemailer": "^6.9.8",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
